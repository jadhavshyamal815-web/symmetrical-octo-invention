{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhiv-biotech.local/schemas/evidence-qc-schema-v1.0.0.json",
  "title": "Biosimilarity and Preclinical Evidence QC Record",
  "description": "Canonical versioned schema for deterministic evidence quality control. This schema does not establish biosimilarity, clinical equivalence, interchangeability, safety, efficacy, or regulatory validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "study_id",
    "source",
    "protocol_reference",
    "sample_identification",
    "control_identification",
    "experimental_conditions",
    "measurement_method",
    "method_validation_status",
    "raw_data_availability",
    "missing_data",
    "deviations",
    "statistical_reporting",
    "reproducibility",
    "limitations",
    "evidence_category",
    "synthetic_data_declaration",
    "reviewer_status",
    "evidence_quality",
    "final_review_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },

    "evidence_id": {
      "type": "string",
      "minLength": 1
    },

    "study_id": {
      "type": "string",
      "minLength": 1
    },

    "source": {
      "type": "string",
      "minLength": 1
    },

    "protocol_reference": {
      "type": "string",
      "minLength": 1
    },

    "sample_identification": {
      "type": "string",
      "minLength": 1
    },

    "control_identification": {
      "type": "string",
      "minLength": 1
    },

    "experimental_conditions": {
      "type": "string",
      "minLength": 1
    },

    "measurement_method": {
      "type": "string",
      "minLength": 1
    },

    "method_validation_status": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "PARTIALLY_VALIDATED",
        "NOT_VALIDATED",
        "NOT_REPORTED"
      ]
    },

    "raw_data_availability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "NOT_AVAILABLE",
        "PARTIAL",
        "NOT_REPORTED"
      ]
    },

    "missing_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "statistical_reporting": {
      "type": "string",
      "minLength": 1
    },

    "reproducibility": {
      "type": "string",
      "minLength": 1
    },

    "limitations": {
      "type": "string",
      "minLength": 1
    },

    "evidence_category": {
      "type": "string",
      "enum": [
        "Analytical",
        "Structural",
        "Functional",
        "PK",
        "PD",
        "Immunogenicity",
        "Preclinical",
        "Clinical"
      ]
    },

    "synthetic_data_declaration": {
      "type": "string",
      "enum": [
        "SAMPLE / SYNTHETIC / FOR SOFTWARE TESTING",
        "REAL / SOURCE-VERIFIED"
      ]
    },

    "reviewer_status": {
      "type": "string",
      "enum": [
        "NOT REVIEWED",
        "IN REVIEW",
        "REVIEWED",
        "REQUIRES SECOND REVIEW",
        "CLOSED"
      ]
    },

    "evidence_quality": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "NEEDS REVIEW",
        "CONFLICTING",
        "INSUFFICIENT"
      ]
    },

    "final_review_status": {
      "type": "string",
      "enum": [
        "OPEN",
        "IN REVIEW",
        "REQUIRES REVISION",
        "READY FOR HUMAN REVIEW",
        "REVIEWED",
        "CLOSED"
      ]
    }
  }
}